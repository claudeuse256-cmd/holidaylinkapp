# Copy to .env and fill in real values. Never commit .env.
PORT=8080

# PostgreSQL connection string (local Termux PostgreSQL by default)
DATABASE_URL=postgres://YOUR_DB_USER@127.0.0.1:5432/holidaylink
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=8000

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anything under 32 characters is refused with a warning: a short secret lets anyone sign their
# own tokens and sign in as any user.
JWT_SECRET=replace-this-with-a-long-random-secret

# Country code assumed when a client sends a national-format number without "+".
DEFAULT_COUNTRY_CODE=256

# OTP policy
OTP_TTL_MINUTES=5
OTP_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_ATTEMPT_WINDOW_MINUTES=15

# Infobip normal SMS API (no 2FA application/message ID required).
# The API key lives only on the server, never in the Android app.
INFOBIP_BASE_URL=https://YOUR-SUBDOMAIN.api.infobip.com
INFOBIP_API_KEY=YOUR_NEW_SMS_API_KEY
INFOBIP_FROM=ServiceSMS

# Google Gemini key used by HolidayLink AI. Server-side only: the Android app calls
# POST /ai/chat and never receives this value, so it cannot be read out of the APK.
# Leave blank to disable AI; the route then returns AI_NOT_CONFIGURED.
GEMINI_API_KEY=

# Comma-separated models, tried in order. If one is unavailable, rate limited or times out the
# next one answers, so AI does not go dark because a single model id was retired.
# Add or remove ids as Google releases and retires them.
GEMINI_MODELS=gemini-3.0-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Where uploaded avatars, status photos and attachments are written.
UPLOAD_DIR=./uploads

# Render/Neon note:
# Set DATABASE_URL to the pooled Neon connection string in Render Environment Variables.
# Set PGSSL_DISABLE=false (default) for Neon TLS. Do not put DATABASE_URL in the Android app.

# Firebase migration: set to neon to make the new database the content source.
CONTENT_SOURCE=neon
# Social videos: hard per-video upload limit.
MAX_VIDEO_MB=100
# Media storage is local only for development; production should use persistent object storage.
MEDIA_STORAGE=local
