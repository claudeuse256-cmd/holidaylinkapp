# Copy to .env and fill in real values. Never commit .env.
PORT=8080

# Country code assumed when a client sends a national-format number without "+".
DEFAULT_COUNTRY_CODE=256

# OTP policy (codes live 5 minutes, fixed to match the SMS text).
OTP_COOLDOWN_SECONDS=45

# Infobip normal SMS API. The key lives only on this server, never in the app.
INFOBIP_BASE_URL=https://YOUR-SUBDOMAIN.api.infobip.com
INFOBIP_API_KEY=YOUR_NEW_SMS_API_KEY
INFOBIP_FROM=HolidayLink

# Firebase Admin SDK service-account JSON (single line). Found in the Firebase
# console under Project settings > Service accounts > Generate new private key.
# Gives this service power to store OTP hashes and mint login tokens.
# Never put this in the Android app or the website frontend.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
