<?xml version="1.0" encoding="utf-8"?>
<!-- Lets HolidayLink chats appear as direct targets in the system share sheet. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="org.holidaylink.app.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="org.holidaylink.app.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
