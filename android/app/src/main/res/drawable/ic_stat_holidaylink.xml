<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for notifications: the SAME chain-link mark as the launcher icon
  (see ic_launcher_foreground.xml), drawn as a white silhouette so Android can tint
  it for light/dark status bars. Keeping the two icons identical is what makes the
  notification read as "HolidayLink" at a glance in the status bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Slight upscale so the mark fills more of the tiny status-bar canvas. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.25"
        android:scaleY="1.25">

        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="-45">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M41,32h26a9,9 0 0 1 9,9v8a9,9 0 0 1 -9,9h-26a9,9 0 0 1 -9,-9v-8a9,9 0 0 1 9,-9z" />
        </group>

        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="135">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M41,32h26a9,9 0 0 1 9,9v8a9,9 0 0 1 -9,9h-26a9,9 0 0 1 -9,-9v-8a9,9 0 0 1 9,-9z" />
        </group>

        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="-45">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M47,48h14a4,4 0 0 1 4,4v4a4,4 0 0 1 -4,4h-14a4,4 0 0 1 -4,-4v-4a4,4 0 0 1 4,-4z" />
        </group>
    </group>
</vector>
