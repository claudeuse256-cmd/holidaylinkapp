<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for notifications: the HolidayLink "H" mark from the brand logo
  (res/drawable/holidaylink_icon.png), drawn as a white silhouette so Android can
  tint it for light and dark status bars.

  A monochrome H is used instead of the full logo because the system only keeps the
  alpha channel of this drawable: a greyed-down copy of the artwork would collapse
  into a solid blob at 24dp. The full-colour logo is still shown as the large icon
  (see Notifier.logo) and as the app icon next to the notification.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left stroke of the H. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M24,30a10,10 0 0 1 10,-10a10,10 0 0 1 10,10v48a10,10 0 0 1 -10,10a10,10 0 0 1 -10,-10z" />

    <!-- Right stroke of the H. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M64,30a10,10 0 0 1 10,-10a10,10 0 0 1 10,10v48a10,10 0 0 1 -10,10a10,10 0 0 1 -10,-10z" />

    <!-- Crossbar, rounded like the logo's speech-bubble band. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44,47h20a8,8 0 0 1 0,16h-20a8,8 0 0 1 0,-16z" />
</vector>
