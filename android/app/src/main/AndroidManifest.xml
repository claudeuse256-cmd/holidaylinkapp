<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Contact matching only: requested at runtime with an explanation, never silently. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Android 13+ notification permission, requested after an explanation. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice messages: requested when the user taps the microphone, never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Status "Add status" gallery: an in-app grid of the phone's recent photos/videos,
        WhatsApp-style, instead of the system picker sheet. Requested at runtime, right
        before the grid is shown, never at launch.
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:maxSdkVersion="35" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        android:maxSdkVersion="35" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Call audio routing (earpiece vs loudspeaker) and keeping the screen awake in a call. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Calls. Since Android 9 any foreground service needs FOREGROUND_SERVICE, and since
        Android 14 (we target 35) every foreground-service *type* needs its own permission.
        The call service is declared phoneCall|microphone|camera and these were missing, so
        startForeground() threw a SecurityException the instant a call was tapped and the
        whole app closed.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!-- In-app self-update: lets the downloaded APK reach the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />


    <!-- App lock with fingerprint / face. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Saving photos/videos to the gallery on Android 9 and older only. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

        <!-- Android 11+ package visibility: needed to reach the system installer. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:name=".HolidayLinkApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@drawable/holidaylink_icon"
        android:roundIcon="@drawable/holidaylink_icon"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.HolidayLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Share" from other apps (gallery, files, TikTok, a browser...) into HolidayLink. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>

            <!-- Chats as direct targets (top of the share sheet). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Firebase Cloud Messaging: delivers notifications while the app is killed. -->
        <service
            android:name=".push.HolidayMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Keeps an active call alive and visible in the notification shade when the user
             leaves the app or locks the screen. -->
        <service
            android:name=".call.CallService"
            android:foregroundServiceType="phoneCall|microphone|camera|mediaProjection"
            android:exported="false" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hl_messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_holidaylink" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Reply / Mark as read buttons on message notifications. -->
        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- Serves the downloaded APK to the system installer during an in-app update. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>